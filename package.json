{
  "name": "agentberth",
  "version": "0.17.0",
  "private": true,
  "type": "module",
  "description": "A project workspace for persistent terminals, agents, files and history",
  "license": "Apache-2.0",
  "main": "dist/main.cjs",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "postinstall": "node scripts/setup.mjs",
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:scripts && node scripts/test.mjs",
    "test:scripts": "node --test tests/setup.test.mjs tests/release.test.mjs tests/installer.test.mjs",
    "test:desktop": "npm run build && node scripts/test-desktop.mjs",
    "test:packaged": "node scripts/test-desktop.mjs --packaged",
    "check": "npm run typecheck && npm test && npm run build",
    "dist:win": "npm run build && electron-builder --win nsis zip --x64 --publish never",
    "test:files": "npm run build && node scripts/smoke-files.mjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/headless": "6.0.0",
    "@xterm/xterm": "6.0.0",
    "ajv": "8.17.1",
    "cordis": "4.0.0-rc.12",
    "fflate": "0.8.2",
    "highlight.js": "11.12.0",
    "js-yaml": "4.3.2",
    "node-pty": "1.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "ssh2": "1.17.0",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ssh2": "^1.15.5",
    "@types/ws": "^8.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "playwright": "1.64.0",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "build": {
    "appId": "dev.agentberth.desktop",
    "productName": "AgentBerth",
    "afterSign": "scripts/installer-payload.mjs",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/main.cjs",
      "dist/preload.cjs",
      "dist/daemon.cjs",
      "dist/renderer/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**/*"
    ],
    "npmRebuild": true,
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "artifactName": "AgentBerth-${version}-windows-${arch}.${ext}",
      "icon": "assets/app.ico"
    },
    "nsis": {
      "include": "build/agentberth-installer.nsh",
      "artifactName": "AgentBerth-${version}-windows-${arch}-setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/app.ico",
      "uninstallerIcon": "assets/app.ico"
    },
    "extraResources": [
      {
        "from": "dist/check-plugin.cjs",
        "to": "plugin-kit/check-plugin.cjs"
      },
      {
        "from": "docs",
        "to": "docs"
      },
      {
        "from": "examples",
        "to": "examples"
      },
      {
        "from": "assets",
        "to": "assets",
        "filter": [
          "app.png",
          "app.ico"
        ]
      },
      {
        "from": "dist/mcp.cjs",
        "to": "mcp/mcp.cjs"
      },
      {
        "from": "dist/pet-hook.cjs",
        "to": "pet/pet-hook.cjs"
      },
      {
        "from": "assets/pet",
        "to": "assets/pet"
      },
      {
        "from": "dist/opencode-pet-v1.mjs",
        "to": "pet/opencode-pet-v1.mjs"
      },
      {
        "from": "dist/opencode-pet-v2.mjs",
        "to": "pet/opencode-pet-v2.mjs"
      }
    ]
  }
}
